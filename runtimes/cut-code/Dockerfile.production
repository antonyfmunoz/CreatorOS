# Candidate only: qualification is not approval for public untrusted execution.
# Rebuild and scan before promotion; the final image digest binds OS packages.
FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium ffmpeg ca-certificates fonts-liberation fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/cut-code
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY bundle.mjs sdk.jsx motion.mjs audio.mjs request.mjs browser.mjs render.mjs ./
RUN dpkg-query -W > /opt/cut-code/os-packages.txt \
    && node --version > /opt/cut-code/node-version.txt \
    && chromium --version > /opt/cut-code/chromium-version.txt
ENV CUT_CODE_CONTAINER=1 CUT_CODE_BROWSER=debian-chromium HOME=/tmp
USER node
ENTRYPOINT ["node", "render.mjs"]
