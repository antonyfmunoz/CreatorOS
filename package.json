{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:demo": "cross-env CREATOROS_DEMO_MODE=true VITE_CREATOROS_DEMO_MODE=true tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "test": "vitest run",
    "verify": "npm run test && npm run check && npm run build && npm run verify:bundle && npm run verify:worker",
    "verify:migrations": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/qualify-migrations.ps1",
    "verify:automations": "tsx scripts/qualify-automation-kernel.ts",
    "verify:social-automations": "tsx scripts/qualify-native-social-automations.ts",
    "verify:relationship-operations": "tsx scripts/qualify-relationship-operations.ts",
    "verify:relationship-release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/qualify-relationship-release.ps1",
    "verify:browser": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/qualify-browser.ps1",
    "verify:production-smoke": "node scripts/qualify-production-smoke.mjs",
    "verify:production-smoke:public": "cross-env CREATIVESOS_PRODUCTION_SMOKE_MODE=public node scripts/qualify-production-smoke.mjs",
    "verify:stitch": "node scripts/qualify-stitch-references.mjs",
    "verify:infrastructure": "node scripts/verify-scaled-infrastructure.mjs && node --test scripts/audit-live-fly-topology.test.mjs scripts/resolve-live-fly-config.test.mjs",
    "verify:media-cloud": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/qualify-media-cloud.ps1",
    "verify:backup-restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/qualify-backup-restore.ps1",
    "verify:secrets": "node scripts/scan-source-secrets.mjs",
    "verify:capacity": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/qualify-capacity.ps1",
    "benchmarks:evidence": "tsx scripts/build-competitive-evidence.ts",
    "verify:worker-resilience": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/qualify-worker-resilience.ps1",
    "verify:bundle": "node scripts/verify-bundle-budget.mjs",
    "verify:worker": "wrangler types workers/distribution-scheduler/worker-configuration.d.ts --config workers/distribution-scheduler/wrangler.jsonc --check && tsc --noEmit --strict --skipLibCheck --module ESNext --moduleResolution Bundler --lib ESNext,WebWorker workers/distribution-scheduler/src/index.ts workers/distribution-scheduler/worker-configuration.d.ts && wrangler deploy --dry-run --config workers/distribution-scheduler/wrangler.jsonc",
    "media:worker": "tsx server/media-worker.ts",
    "cut:worker": "tsx server/cut-worker.ts",
    "mobile:assets": "node scripts/generate-native-brand-assets.mjs",
    "mobile:sync": "npm run build && cap sync && node scripts/fix-capacitor-ios-package.mjs",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "verify:mobile": "node scripts/fix-capacitor-ios-package.mjs && node scripts/verify-native-mobile.mjs",
    "verify:release-local": "npm run verify && npm run verify:stitch && npm run verify:infrastructure && npm run verify:mobile && npm run verify:relationship-release && npm run verify:worker-resilience && npm run verify:browser && npm run verify:backup-restore && npm run verify:secrets && npm run verify:capacity",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@aws-sdk/s3-request-presigner": "^3.1103.0",
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/background-runner": "3.0.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0",
