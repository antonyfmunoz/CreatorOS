{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:demo": "cross-env CREATOROS_DEMO_MODE=true VITE_CREATOROS_DEMO_MODE=true tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "test": "vitest run",
    "verify": "npm run test && npm run check && npm run build && npm run verify:bundle && npm run verify:worker",
    "verify:migrations": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/qualify-migrations.ps1",
    "verify:automations": "tsx scripts/qualify-automation-kernel.ts",
    "verify:social-automations": "tsx scripts/qualify-native-social-automations.ts",
    "verify:relationship-operations": "tsx scripts/qualify-relationship-operations.ts",
    "verify:relationship-release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/qualify-relationship-release.ps1",
    "verify:browser": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/qualify-browser.ps1",
    "verify:backup-restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/qualify-backup-restore.ps1",
    "verify:secrets": "node scripts/scan-source-secrets.mjs",
    "verify:capacity": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/qualify-capacity.ps1",
    "verify:bundle": "node scripts/verify-bundle-budget.mjs",
    "verify:worker": "wrangler types workers/distribution-scheduler/worker-configuration.d.ts --config workers/distribution-scheduler/wrangler.jsonc --check && tsc --noEmit --strict --skipLibCheck --module ESNext --moduleResolution Bundler --lib ESNext,WebWorker workers/distribution-scheduler/src/index.ts workers/distribution-scheduler/worker-configuration.d.ts && wrangler deploy --dry-run --config workers/distribution-scheduler/wrangler.jsonc",
    "verify:release-local": "npm run verify && npm run verify:relationship-release && npm run verify:browser && npm run verify:backup-restore && npm run verify:secrets && npm run verify:capacity",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push"
  },
